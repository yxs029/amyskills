# QQ Agent Mail Configuration
AGENTLY_BASE_URL=https://api.agent.qq.com
AGENTLY_ACCESS_TOKEN=REPLACE_WITH_YOUR_TOKEN
AGENTLY_EMAIL=unknown@agent.qq.com

# File access whitelist
ALLOWED_READ_DIRS=/Users/example/Documents
ALLOWED_WRITE_DIRS=/Users/example/Downloads

# Token source (used to decide whether runtime auto-refresh may overwrite this file)
TOKEN_SOURCE=credential_service
