{
  "name": "dsh-local-otagent-sidebar",
  "version": "0.1.0",
  "description": "Sidebar panels for driving local Hermes / OpenClaw agents over ACP inside the DSH Web GUI",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": {
      "default": "./lib/index.mjs"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/wrap-client.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm build && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@agentclientprotocol/sdk": "^1.4.0"
  },
  "devDependencies": {
    "tsdown": "^0.23.7",
    "typescript": "^5.7.0",
    "vitest": "^5.1.0",
    "@types/node": "^22.0.0",
    "react": "^18.2.0",
    "@types/react": "^18.2.0"
  }
}
